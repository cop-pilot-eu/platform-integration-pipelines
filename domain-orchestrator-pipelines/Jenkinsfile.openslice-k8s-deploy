/************************************************************
 * HELPERS
 ************************************************************/
// Runs the given body with KUBECONFIG pointing to the Jenkins "Secret file"
// credential that holds the kubeconfig of the target cluster.
def withKube(Closure body) {
    withCredentials([file(credentialsId: params.KUBECONFIG_CREDENTIALS_ID, variable: 'KUBECONFIG')]) {
        body()
    }
}

pipeline {
    /************************************************************
     * PARAMETERS
     ************************************************************/
    parameters {
        string(
            name: 'NODE_LABEL',
            defaultValue: 'cop-pilot-staging-cluster',
            description: 'Jenkins node label where the pipeline runs (needs kubectl, helm, git, curl)'
        )

        string(
            name: 'KUBECONFIG_CREDENTIALS_ID',
            defaultValue: 'staging-kubeconfig',
            description: 'Jenkins credential ID (type: Secret file) with the kubeconfig of the target cluster'
        )

        string(
            name: 'OSL_VERSION',
            defaultValue: '2025Q4',
            description: 'OpenSlice release to deploy: git tag/branch of org.etsi.osl.main (e.g. 2025Q4, 2026Q2, main, develop)'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Tag for the OpenSlice images. Empty = derived from OSL_VERSION (main -> latest, develop -> develop, otherwise = OSL_VERSION)'
        )

        string(
            name: 'NAMESPACE',
            defaultValue: 'openslice',
            description: 'Kubernetes namespace for the OpenSlice deployment'
        )

        string(
            name: 'HELM_RELEASE',
            defaultValue: 'openslice',
            description: 'Helm release name for OpenSlice'
        )

        string(
            name: 'ROOT_URL',
            defaultValue: '',
            description: 'Public root URL of OpenSlice (e.g. http://<node-ip>:<ingress-nodeport>). Auto-detected from the cluster if empty.'
        )

        string(
            name: 'STORAGE_CLASS',
            defaultValue: '',
            description: 'StorageClass for MySQL. Empty = chart default (hostPath PV at /dockerdata-nfs/osmysql, single-node clusters only)'
        )

        string(
            name: 'HELM_TIMEOUT',
            defaultValue: '20m',
            description: 'Timeout for helm upgrade --install --wait'
        )

        // Credentials
        password(
            name: 'MYSQL_ROOT_PASSWORD',
            defaultValue: 'letmein',
            description: 'MySQL root password'
        )

        password(
            name: 'KEYCLOAK_ADMIN_PASSWORD',
            defaultValue: 'Pa55w0rd',
            description: 'Keycloak admin password'
        )

        // Ingress configuration
        string(
            name: 'INGRESS_NODEPORT_HTTP',
            defaultValue: '',
            description: 'NodePort for HTTP ingress (auto-detected if empty)'
        )

        // CRIDGE
        booleanParam(
            name: 'ENABLE_CRIDGE',
            defaultValue: true,
            description: 'Deploy CRIDGE component for Kubernetes CR management'
        )

        string(
            name: 'CRIDGE_KUBECONFIG_CREDENTIALS_ID',
            defaultValue: '',
            description: 'Jenkins credential ID (Secret file) with the kubeconfig CRIDGE will manage. Empty = same as KUBECONFIG_CREDENTIALS_ID'
        )

        // Keycloak SSL disable
        booleanParam(
            name: 'DISABLE_KEYCLOAK_SSL',
            defaultValue: true,
            description: 'Disable Keycloak SSL requirement (for HTTP deployments)'
        )
    }

    /************************************************************
     * AGENT
     ************************************************************/
    agent {
        label "${params.NODE_LABEL}"
    }

    /************************************************************
     * ENVIRONMENT
     ************************************************************/
    environment {
        WORK_DIR    = 'openslice-deploy'
        REPO_URL    = 'https://labs.etsi.org/rep/osl/code/org.etsi.osl.main.git'
        CHART_DIR   = 'openslice-deploy/org.etsi.osl.main/kubernetes/helm/openslice'
        // Generated values (contains secrets) - kept outside the chart dir, removed in post
        VALUES_OVERRIDE = 'openslice-deploy/values-override.yaml'
        ROOT_URL_FILE   = 'openslice-deploy/root_url'
    }

    options { timestamps() }

    /************************************************************
     * STAGES
     ************************************************************/
    stages {

        // ****************************
        // *** VALIDATE ENVIRONMENT ***
        // ****************************
        stage('Validate environment') {
            steps {
                script {
                    withKube {
                        sh '''#!/usr/bin/env bash
                            set -eu

                            echo "Checking prerequisites..."
                            for bin in kubectl helm git curl; do
                                command -v "$bin" >/dev/null 2>&1 || { echo "ERROR: $bin not found"; exit 1; }
                            done

                            kubectl version --client
                            helm version --short

                            echo "Checking cluster connectivity..."
                            kubectl cluster-info >/dev/null || { echo "ERROR: Cannot connect to Kubernetes cluster"; exit 1; }
                            kubectl get nodes -o wide

                            echo "All prerequisites met."
                        '''
                    }
                }
            }
        }

        // ****************************
        // *** CLONE REPOSITORY     ***
        // ****************************
        stage('Clone OpenSlice repository') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -eu

                    rm -rf "${WORK_DIR}"
                    mkdir -p "${WORK_DIR}"

                    echo "Cloning org.etsi.osl.main @ ${OSL_VERSION}"
                    git clone --branch "${OSL_VERSION}" --depth 1 "${REPO_URL}" "${WORK_DIR}/org.etsi.osl.main"

                    echo "Chart:"
                    grep -E '^(version|appVersion):' "${CHART_DIR}/Chart.yaml"
                '''
            }
        }

        // ****************************
        // *** CONFIGURE WEB UIs    ***
        // ****************************
        stage('Configure Web UIs') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -eu

                    # Copy <dir>/<default> to <dir>/<target> if the default exists and the target does not
                    from_default() {
                        if [ -f "$1/$2" ] && [ ! -f "$1/$3" ]; then
                            cp "$1/$2" "$1/$3"
                            echo "Created $3 from $2."
                        fi
                    }

                    WEB_JS_DIR="${CHART_DIR}/files/org.etsi.osl.portal.web/src/js"
                    TMF_CFG_DIR="${CHART_DIR}/files/org.etsi.osl.tmf.web/src/assets/config"

                    from_default "${WEB_JS_DIR}"  config.js.default             config.js
                    from_default "${TMF_CFG_DIR}" config.prod.default.json      config.prod.json
                    from_default "${TMF_CFG_DIR}" config.theming.default.json   config.theming.json
                    from_default "${TMF_CFG_DIR}" theming.default.scss          theming.scss

                    echo "Web UI configuration files ready."
                '''
            }
        }

        // ************************************
        // *** SETUP NGINX INGRESS (if needed)
        // ************************************
        stage('Ensure NGINX Ingress Controller') {
            steps {
                script {
                    withKube {
                        sh '''#!/usr/bin/env bash
                            set -eu

                            if kubectl get ingressclass nginx >/dev/null 2>&1; then
                                echo "IngressClass 'nginx' already exists - using the existing controller."
                                echo "NOTE: Artemis TCP passthrough (61616) is only configured when this pipeline installs the controller."
                            else
                                echo "Installing NGINX Ingress Controller (NodePort)..."
                                helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx >/dev/null 2>&1 || true
                                helm repo update ingress-nginx

                                helm upgrade --install nginx-ingress ingress-nginx/ingress-nginx \
                                    --namespace ingress --create-namespace \
                                    --set controller.service.type=NodePort \
                                    --set tcp.61616="${NAMESPACE}/${HELM_RELEASE}-artemis:61616" \
                                    --wait --timeout 5m
                            fi
                        '''
                    }
                }
            }
        }

        // *********************************
        // *** CONFIGURE HELM VALUES     ***
        // *********************************
        stage('Configure Helm values') {
            steps {
                script {
                    withKube {
                        sh '''#!/usr/bin/env bash
                            set -eu

                            # YAML single-quoted scalar (safe for any password)
                            q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"; }

                            # ---- Root URL ----
                            if [ -n "${ROOT_URL}" ]; then
                                FINAL_ROOT_URL="${ROOT_URL%/}"
                            else
                                NODE_IP=$(kubectl get nodes -o jsonpath='{.items[0].status.addresses[?(@.type=="ExternalIP")].address}')
                                [ -n "$NODE_IP" ] || NODE_IP=$(kubectl get nodes -o jsonpath='{.items[0].status.addresses[?(@.type=="InternalIP")].address}')

                                NODEPORT="${INGRESS_NODEPORT_HTTP}"
                                if [ -z "$NODEPORT" ]; then
                                    NODEPORT=$(kubectl get svc -A \
                                        -l app.kubernetes.io/name=ingress-nginx,app.kubernetes.io/component=controller \
                                        -o jsonpath='{.items[0].spec.ports[?(@.name=="http")].nodePort}' 2>/dev/null || true)
                                fi
                                [ -n "$NODEPORT" ] || { echo "ERROR: could not detect ingress NodePort - set ROOT_URL or INGRESS_NODEPORT_HTTP"; exit 1; }

                                FINAL_ROOT_URL="http://${NODE_IP}:${NODEPORT}"
                            fi
                            echo "${FINAL_ROOT_URL}" > "${ROOT_URL_FILE}"
                            echo "Root URL: ${FINAL_ROOT_URL}"

                            # ---- Image tag ----
                            TAG="${IMAGE_TAG}"
                            if [ -z "$TAG" ]; then
                                case "${OSL_VERSION}" in
                                    main)    TAG=latest ;;
                                    develop) TAG=develop ;;
                                    *)       TAG="${OSL_VERSION}" ;;
                                esac
                            fi
                            echo "OpenSlice image tag: ${TAG}"

                            # ---- Override values (instead of editing the chart's values.yaml) ----
                            umask 077
                            {
                                echo "rooturl: $(q "${FINAL_ROOT_URL}")"
                                [ -z "${STORAGE_CLASS}" ] || echo "storageClass: $(q "${STORAGE_CLASS}")"
                                echo "oscreds:"
                                echo "  mysql:"
                                echo "    password: $(q "${MYSQL_ROOT_PASSWORD}")"
                                echo "    keycloak:"
                                echo "      adminpassword: $(q "${KEYCLOAK_ADMIN_PASSWORD}")"
                                echo "cridge:"
                                echo "  enabled: ${ENABLE_CRIDGE}"
                                echo "image:"
                                for img in bugzilla centrallog manoclient osom portalapi osscapi oasapi \
                                           portalweb tmfweb cridge metrico mcpserver mcpbackend; do
                                    echo "  ${img}:"
                                    echo "    tag: $(q "${TAG}")"
                                done
                            } > "${VALUES_OVERRIDE}"

                            echo "Helm override values written (secrets masked):"
                            sed -E "s/(password: ).*/\\1'****'/" "${VALUES_OVERRIDE}"
                        '''
                    }
                }
            }
        }

        // ****************************
        // *** DEPLOY OPENSLICE     ***
        // ****************************
        stage('Deploy OpenSlice') {
            steps {
                script {
                    def cridgeCredId = params.CRIDGE_KUBECONFIG_CREDENTIALS_ID?.trim() ?: params.KUBECONFIG_CREDENTIALS_ID
                    withKube {
                        withCredentials([file(credentialsId: cridgeCredId, variable: 'CRIDGE_KUBECONFIG')]) {
                            sh '''#!/usr/bin/env bash
                                set -eu

                                HELM_EXTRA_ARGS=()
                                if [ "${ENABLE_CRIDGE}" = "true" ]; then
                                    # The chart refuses to render CRIDGE without a kubeconfig
                                    HELM_EXTRA_ARGS+=(--set-file "cridge.kubeconfig.raw=${CRIDGE_KUBECONFIG}")
                                    echo "CRIDGE kubeconfig provided from Jenkins credentials."
                                fi

                                echo "Deploying OpenSlice (${OSL_VERSION}) with Helm..."
                                helm upgrade --install "${HELM_RELEASE}" "${CHART_DIR}" \
                                    --namespace "${NAMESPACE}" \
                                    --create-namespace \
                                    -f "${VALUES_OVERRIDE}" \
                                    "${HELM_EXTRA_ARGS[@]}" \
                                    --timeout "${HELM_TIMEOUT}" \
                                    --wait

                                echo "Helm deployment completed."
                                helm list -n "${NAMESPACE}" --filter "^${HELM_RELEASE}\\$"
                            '''
                        }
                    }
                }
            }
        }

        // ****************************************
        // *** WAIT FOR WORKLOADS TO BE READY   ***
        // ****************************************
        stage('Wait for workloads') {
            steps {
                script {
                    withKube {
                        sh '''#!/usr/bin/env bash
                            set -eu

                            SEL="app.kubernetes.io/instance=${HELM_RELEASE}"

                            echo "Waiting for deployments/statefulsets of release ${HELM_RELEASE}..."
                            for w in $(kubectl get deploy,statefulset -n "${NAMESPACE}" -l "${SEL}" -o name); do
                                kubectl rollout status -n "${NAMESPACE}" "$w" --timeout=10m
                            done

                            echo ""
                            echo "===== Pods ====="
                            kubectl get pods -n "${NAMESPACE}" -o wide
                            echo ""
                            echo "===== Services ====="
                            kubectl get svc -n "${NAMESPACE}"
                            echo ""
                            echo "===== Ingress ====="
                            kubectl get ingress -n "${NAMESPACE}"
                        '''
                    }
                }
            }
        }

        // ****************************************
        // *** DISABLE KEYCLOAK SSL (optional)  ***
        // ****************************************
        stage('Disable Keycloak SSL') {
            when {
                expression { return params.DISABLE_KEYCLOAK_SSL }
            }
            steps {
                script {
                    withKube {
                        sh '''#!/usr/bin/env bash
                            set -eu

                            KC_POD=$(kubectl get pods -n "${NAMESPACE}" \
                                -l "org.etsi.osl.service=keycloak,app.kubernetes.io/instance=${HELM_RELEASE}" \
                                --field-selector=status.phase=Running \
                                -o jsonpath='{.items[0].metadata.name}')
                            [ -n "$KC_POD" ] || { echo "ERROR: Keycloak pod not found"; exit 1; }
                            echo "Keycloak pod: ${KC_POD}"

                            # The admin password is sent via stdin so that it does not need shell quoting
                            for i in $(seq 1 30); do
                                if printf '%s\\n' "${KEYCLOAK_ADMIN_PASSWORD}" | kubectl exec -i -n "${NAMESPACE}" "${KC_POD}" -- /bin/sh -c '
                                    read -r KCPASS
                                    cd /opt/jboss/keycloak/bin 2>/dev/null || cd /opt/keycloak/bin
                                    ./kcadm.sh config credentials --server http://localhost:8080/auth \
                                        --realm master --user admin --password "$KCPASS" >/dev/null &&
                                    ./kcadm.sh update realms/openslice -s sslRequired=NONE &&
                                    ./kcadm.sh update realms/master -s sslRequired=NONE
                                '; then
                                    echo "Keycloak SSL requirement disabled for 'openslice' and 'master' realms."
                                    exit 0
                                fi
                                echo "Keycloak not ready yet (attempt $i/30)..."
                                sleep 10
                            done

                            echo "ERROR: could not disable Keycloak SSL requirement."
                            exit 1
                        '''
                    }
                }
            }
        }

        // ****************************************
        // *** SMOKE TEST                       ***
        // ****************************************
        stage('Smoke test') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -eu

                    TEST_URL=$(cat "${ROOT_URL_FILE}")
                    echo "Smoke testing OpenSlice at: ${TEST_URL}"

                    # <name> <path> <accepted HTTP codes regex>
                    check() {
                        for i in $(seq 1 30); do
                            CODE=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 "${TEST_URL}$2" || true)
                            if [[ "$CODE" =~ ^($3)$ ]]; then
                                echo "OK   $1 -> HTTP ${CODE}"
                                return 0
                            fi
                            echo "...  $1 -> HTTP ${CODE} (attempt $i/30)"
                            sleep 10
                        done
                        echo "FAIL $1 (${TEST_URL}$2)"
                        return 1
                    }

                    check "TMF Web UI"        "/"                                                   "200"
                    check "Keycloak realm"    "/auth/realms/openslice"                              "200"
                    check "TMF Service API"   "/tmf-api/serviceCatalogManagement/v4/serviceCatalog" "200|401"

                    echo ""
                    echo "OpenSlice ${OSL_VERSION} deployed successfully."
                    echo "Access OpenSlice at: ${TEST_URL}"
                    echo "Keycloak admin:      ${TEST_URL}/auth"
                '''
            }
        }
    }

    /************************************************************
     * POST ACTIONS
     ************************************************************/
    post {
        success {
            echo "OpenSlice ${params.OSL_VERSION} deployed in namespace '${params.NAMESPACE}' (release '${params.HELM_RELEASE}')."
        }
        failure {
            echo "OpenSlice deployment failed. Current state of namespace '${params.NAMESPACE}':"
            script {
                try {
                    withKube {
                        sh 'kubectl get pods -n "${NAMESPACE}" -o wide || true'
                    }
                } catch (err) {
                    echo "Could not query the cluster: ${err}"
                }
            }
        }
        always {
            sh 'rm -rf "${WORK_DIR}" || true'
        }
    }
}
