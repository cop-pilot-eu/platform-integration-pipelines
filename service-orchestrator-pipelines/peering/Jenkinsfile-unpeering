pipeline {
  agent { node { label 'doc-vm' } }

  parameters {
    string(name: 'TMF_PARTY_ORG', defaultValue: '', description: 'Name of the peered organization to remove from HypO (e.g. openslice-cl4-jig)')
  }

  environment {
    TOKEN_URL = "http://auth.multi-domain-orchestrator.cop-pilot.rid-intrasoft.eu:30081/realms/tmf/protocol/openid-connect/token"
    CLIENT_ID = "tmf-api"

    MAESTRO_TMF_BASE = "http://135.181.84.48:30088"
    ORG_PATH         = "/tmf-api/party/v4/organization"
  }

  options { timestamps() }

  stages {
    stage('Get OAuth Token') {
      steps {
        withCredentials([
          usernamePassword(credentialsId: 'hypo_kc_credentials', usernameVariable: 'KC_USERNAME', passwordVariable: 'KC_PASSWORD'),
          string(credentialsId: 'tmf_api_client_secret', variable: 'KC_CLIENT_SECRET')
        ]) {
          sh '''#!/usr/bin/env bash
set -euo pipefail

test -n "${TMF_PARTY_ORG// /}" || { echo "TMF_PARTY_ORG is empty"; exit 2; }
test -n "${KC_USERNAME}" || { echo "KC_USERNAME is empty"; exit 2; }
test -n "${KC_PASSWORD}" || { echo "KC_PASSWORD is empty"; exit 2; }

HTTP_CODE=$(curl -sS -o token_body.json -w "%{http_code}" -X POST "$TOKEN_URL" \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -H "Accept: application/json" \
  --data-urlencode "grant_type=password" \
  --data-urlencode "client_id=$CLIENT_ID" \
  --data-urlencode "client_secret=$KC_CLIENT_SECRET" \
  --data-urlencode "username=$KC_USERNAME" \
  --data-urlencode "password=$KC_PASSWORD" || true)

echo "Token HTTP status: ${HTTP_CODE}"

if [ "$HTTP_CODE" != "200" ]; then
  echo "Token request failed. Body preview:"
  head -c 400 token_body.json || true
  echo
  exit 2
fi

ACCESS_TOKEN=$(python3 - <<'PY'
import json
with open("token_body.json","r",encoding="utf-8",errors="replace") as f:
    data=json.load(f)
print(data["access_token"])
PY
)

test -n "$ACCESS_TOKEN"
echo "Token acquired successfully (not printing it)."
printf "%s" "$ACCESS_TOKEN" > access_token.txt
'''
        }
      }
    }

    stage('Find Organization ID') {
      steps {
        sh '''#!/usr/bin/env bash
set -euo pipefail

TOKEN=$(cat access_token.txt)
URL="${MAESTRO_TMF_BASE}${ORG_PATH}"
echo "GET ${URL}"

HTTP_CODE=$(curl -sS -o organizations.json -w "%{http_code}" -X GET "$URL" \
  -H "Authorization: Bearer $TOKEN" \
  -H "Accept: application/json" || true)

echo "List Organizations HTTP status: ${HTTP_CODE}"

if [ "$HTTP_CODE" != "200" ]; then
  echo "ERROR: List Organizations failed. Body preview:"
  head -c 400 organizations.json || true
  echo
  exit 2
fi

python3 - <<'PY'
import json, os

target = os.environ["TMF_PARTY_ORG"].strip()

with open("organizations.json", "r", encoding="utf-8") as f:
    resp = json.load(f)

if not isinstance(resp, list):
    raise SystemExit("ERROR: organizations.json is not a JSON array")

# Stored names may carry stray whitespace (e.g. " openslice-cl4-jig"), so compare stripped
matches = [
    obj for obj in resp
    if isinstance(obj, dict) and (obj.get("name") or "").strip() == target
]

if not matches:
    print(f"ERROR: No organization named '{target}' found. Existing organizations:")
    for obj in resp:
        if isinstance(obj, dict):
            print(f"- '{obj.get('name')}' (id={obj.get('id')})")
    raise SystemExit(2)

if len(matches) > 1:
    print(f"ERROR: {len(matches)} organizations named '{target}' found; refusing to guess which one to delete:")
    for obj in matches:
        print(f"- '{obj.get('name')}' (id={obj.get('id')})")
    raise SystemExit(2)

org_id = matches[0].get("id")
if not org_id:
    raise SystemExit(f"ERROR: Organization '{target}' has no id")

print(f"Found organization '{matches[0].get('name')}' with id={org_id}")

with open("org_id.txt", "w", encoding="utf-8") as f:
    f.write(org_id)
PY
'''
      }
    }

    stage('Delete Organization in Maestro TMF') {
      steps {
        sh '''#!/usr/bin/env bash
set -euo pipefail

TOKEN=$(cat access_token.txt)
ORG_ID=$(cat org_id.txt)
URL="${MAESTRO_TMF_BASE}${ORG_PATH}/${ORG_ID}"
echo "DELETE ${URL}"

HTTP_CODE=$(curl -sS -o delete_org_resp.json -w "%{http_code}" -X DELETE "$URL" \
  -H "Authorization: Bearer $TOKEN" \
  -H "Accept: application/json" || true)

echo "Delete Organization HTTP status: ${HTTP_CODE}"
echo "Response body:"
cat delete_org_resp.json || true
echo
echo "---- end delete response ----"

if [ "$HTTP_CODE" != "200" ] && [ "$HTTP_CODE" != "202" ] && [ "$HTTP_CODE" != "204" ]; then
  echo "ERROR: Delete Organization failed"
  exit 2
fi
'''
        script {
          currentBuild.description = "Removed: ${params.TMF_PARTY_ORG.trim()}"
        }
      }
    }
  }

  post {
    always {
      sh '''#!/usr/bin/env bash
rm -f access_token.txt token_body.json organizations.json org_id.txt delete_org_resp.json || true
'''
    }
  }
}
