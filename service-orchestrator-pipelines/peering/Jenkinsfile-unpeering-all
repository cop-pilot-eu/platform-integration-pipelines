pipeline {
  agent { node { label 'doc-vm' } }

  parameters {
    booleanParam(name: 'DRY_RUN', defaultValue: true, description: 'If checked, only list the organizations that would be deleted; uncheck to actually delete them')
  }

  environment {
    TOKEN_URL = "http://auth.multi-domain-orchestrator.cop-pilot.rid-intrasoft.eu:30081/realms/tmf/protocol/openid-connect/token"
    CLIENT_ID = "tmf-api"

    MAESTRO_TMF_BASE = "http://135.181.84.48:30088"
    ORG_PATH         = "/tmf-api/party/v4/organization"
  }

  options { timestamps() }

  stages {
    stage('Get OAuth Token') {
      steps {
        withCredentials([
          usernamePassword(credentialsId: 'hypo_kc_credentials', usernameVariable: 'KC_USERNAME', passwordVariable: 'KC_PASSWORD'),
          string(credentialsId: 'tmf_api_client_secret', variable: 'KC_CLIENT_SECRET')
        ]) {
          sh '''#!/usr/bin/env bash
set -euo pipefail

test -n "${KC_USERNAME}" || { echo "KC_USERNAME is empty"; exit 2; }
test -n "${KC_PASSWORD}" || { echo "KC_PASSWORD is empty"; exit 2; }

HTTP_CODE=$(curl -sS -o token_body.json -w "%{http_code}" -X POST "$TOKEN_URL" \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -H "Accept: application/json" \
  --data-urlencode "grant_type=password" \
  --data-urlencode "client_id=$CLIENT_ID" \
  --data-urlencode "client_secret=$KC_CLIENT_SECRET" \
  --data-urlencode "username=$KC_USERNAME" \
  --data-urlencode "password=$KC_PASSWORD" || true)

echo "Token HTTP status: ${HTTP_CODE}"

if [ "$HTTP_CODE" != "200" ]; then
  echo "Token request failed. Body preview:"
  head -c 400 token_body.json || true
  echo
  exit 2
fi

ACCESS_TOKEN=$(python3 - <<'PY'
import json
with open("token_body.json","r",encoding="utf-8",errors="replace") as f:
    data=json.load(f)
print(data["access_token"])
PY
)

test -n "$ACCESS_TOKEN"
echo "Token acquired successfully (not printing it)."
printf "%s" "$ACCESS_TOKEN" > access_token.txt
'''
        }
      }
    }

    stage('List Organizations to Delete') {
      steps {
        sh '''#!/usr/bin/env bash
set -euo pipefail

TOKEN=$(cat access_token.txt)
URL="${MAESTRO_TMF_BASE}${ORG_PATH}"
echo "GET ${URL}"

HTTP_CODE=$(curl -sS -o organizations.json -w "%{http_code}" -X GET "$URL" \
  -H "Authorization: Bearer $TOKEN" \
  -H "Accept: application/json" || true)

echo "List Organizations HTTP status: ${HTTP_CODE}"

if [ "$HTTP_CODE" != "200" ]; then
  echo "ERROR: List Organizations failed. Body preview:"
  head -c 400 organizations.json || true
  echo
  exit 2
fi

python3 - <<'PY'
import json

# Organizations that must never be deleted (compared stripped, case-insensitive)
KEEP_ORGS = {
    "UBITECH",
}
keep = {n.strip().lower() for n in KEEP_ORGS}

with open("organizations.json", "r", encoding="utf-8") as f:
    resp = json.load(f)

if not isinstance(resp, list):
    raise SystemExit("ERROR: organizations.json is not a JSON array")

to_delete = []
print("==== Organizations ====")
for obj in resp:
    if not isinstance(obj, dict):
        continue
    name = obj.get("name") or ""
    oid = obj.get("id")
    if name.strip().lower() in keep:
        print(f"KEEP    '{name}' (id={oid})")
        continue
    if not oid:
        print(f"SKIP    '{name}' (no id)")
        continue
    print(f"DELETE  '{name}' (id={oid})")
    to_delete.append({"id": oid, "name": name})

print(f"==== To delete: {len(to_delete)} ====")

with open("orgs_to_delete.json", "w", encoding="utf-8") as f:
    json.dump(to_delete, f, indent=2)
PY
'''
      }
    }

    stage('Delete Organizations in Maestro TMF') {
      steps {
        sh '''#!/usr/bin/env bash
set -euo pipefail

TOKEN=$(cat access_token.txt)
COUNT=$(python3 -c 'import json; print(len(json.load(open("orgs_to_delete.json"))))')

if [ "$COUNT" = "0" ]; then
  echo "Nothing to delete."
  exit 0
fi

if [ "${DRY_RUN}" = "true" ]; then
  echo "[DRY_RUN] Would delete ${COUNT} organization(s) listed above. Rerun with DRY_RUN unchecked to delete them."
  exit 0
fi

# One "id<TAB>name" per line
python3 - <<'PY' > orgs_to_delete.tsv
import json
for o in json.load(open("orgs_to_delete.json", encoding="utf-8")):
    print(f"{o['id']}\\t{o['name']}")
PY

FAILED=0
while IFS=$'\\t' read -r ORG_ID ORG_NAME; do
  URL="${MAESTRO_TMF_BASE}${ORG_PATH}/${ORG_ID}"
  HTTP_CODE=$(curl -sS -o delete_org_resp.json -w "%{http_code}" -X DELETE "$URL" \
    -H "Authorization: Bearer $TOKEN" \
    -H "Accept: application/json" || true)

  if [ "$HTTP_CODE" = "200" ] || [ "$HTTP_CODE" = "202" ] || [ "$HTTP_CODE" = "204" ]; then
    echo "Deleted '${ORG_NAME}' (id=${ORG_ID}) HTTP ${HTTP_CODE}"
  else
    echo "ERROR: Failed to delete '${ORG_NAME}' (id=${ORG_ID}) HTTP ${HTTP_CODE}. Body preview:"
    head -c 400 delete_org_resp.json || true
    echo
    FAILED=$((FAILED + 1))
  fi
done < orgs_to_delete.tsv

echo "==== Deleted: $((COUNT - FAILED)), failed: ${FAILED} ===="

if [ "$FAILED" != "0" ]; then
  exit 2
fi
'''
        script {
          currentBuild.description = params.DRY_RUN ? 'Dry run: nothing deleted' : 'All organizations except UBITECH removed'
        }
      }
    }
  }

  post {
    always {
      sh '''#!/usr/bin/env bash
rm -f access_token.txt token_body.json organizations.json orgs_to_delete.json orgs_to_delete.tsv delete_org_resp.json || true
'''
    }
  }
}
